APP_NAME="Rapor Digital SDIT"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://yourdomain.com
FORCE_HTTPS=true

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

GEMINI_API_KEY=your_gemini_api_key_here
BCRYPT_ROUNDS=12
ILOVEPDF_PUBLIC_KEY=your_ilovepdf_public_key_here
ILOVEPDF_SECRET_KEY=your_ilovepdf_secret_key_here

LOG_CHANNEL=stack
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database
DB_USERNAME=your_username
DB_PASSWORD=

GOOGLE_APPLICATION_CREDENTIALS=/path/to/google-credentials.json
DIALOGFLOW_PROJECT_ID=your_dialogflow_project_id
DIALOGFLOW_LANGUAGE=id

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_TABLE=sessions
SESSION_CONNECTION=mysql

BROADCAST_DRIVER=pusher
PUSHER_APP_ID=your_pusher_app_id
PUSHER_APP_KEY=your_pusher_app_key
PUSHER_APP_SECRET=your_pusher_app_secret
PUSHER_APP_CLUSTER=ap1

PDF_MEMORY_LIMIT=1024M
PDF_TIME_LIMIT=300
PDF_CONCURRENT_LIMIT=3

LIBREOFFICE_TIMEOUT=60
LIBREOFFICE_MEMORY_LIMIT=512M
LIBREOFFICE_PATH="C:\\Program Files\\LibreOffice\\program\\soffice.exe"
PDF_CONVERSION_TIMEOUT=120
PDF_CONVERSION_ENABLED=true
REPORT_PDF_AUTO_PREPARE_ENABLED=false
REPORT_PDF_AUTO_PREPARE_DELAY_SECONDS=60
REPORT_PDF_LATE_STAGE_WARMUP_DELAY_SECONDS=10
REPORT_PDF_AUTO_PREPARE_QUEUE=pdf-warm
REPORT_PDF_DASHBOARD_WARMUP_ENABLED=false
REPORT_PDF_DASHBOARD_WARMUP_COOLDOWN_SECONDS=900

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
